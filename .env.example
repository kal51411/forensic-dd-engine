# ============================================================
# Forensic DD Engine — Backend Environment Variables
# Copy this file to .env and customize as needed
# ============================================================

# --- CORS ---
# Comma-separated list of allowed frontend origins (e.g., your Vercel URL)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.vercel.app

# --- Neo4j Graph Database ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=forensicpassword

# --- SEC EDGAR Integration ---
# Required user-agent string as mandated by SEC policy (Format: Sample Company AdminContact@<sample company domain>.com)
SEC_USER_AGENT=ForensicAuditResearch audit@forensicresearch.org

# --- Cache Directory ---
CACHE_DIR=.cache/edgar

# --- Environment ---
ENVIRONMENT=development
PORT=8000
